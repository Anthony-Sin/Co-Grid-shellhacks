# Copy to .env and fill in if needed. NEVER commit .env.
# All primary data sources (HIFLD, OSM Overpass, PSC filings) are public and
# require NO keys. This file exists for optional extras only.

# Optional: higher-rate-limit Overpass mirror
OVERPASS_URL=https://overpass-api.de/api/interpreter

# AI agent (server-side only — the key must never reach the browser bundle)
# OpenAI-compatible chat-completions endpoint (e.g. tensormux).
AGENT_API_KEY=
AGENT_BASE_URL=https://api.tensormux.com/v1
AGENT_MODEL=glm-4-7-flash

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGIN=http://127.0.0.1:3210

# Frontend (Vite picks up VITE_* vars)
VITE_API_BASE=http://127.0.0.1:8000
